# ============================================================
# Docker 部署环境变量示例
#
# 通常无需手动创建：执行 ./deploy.sh up 会自动生成 .env 并填入随机密钥。
# 本文件仅作为字段说明与手动部署时的参考模板。
#
# 本文件已被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================

# ---- MySQL ----
# root 密码，必填
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rbac_admin

# ---- Redis ----
# 留空则 Redis 不启用密码（仅限可信内网）
REDIS_PASSWORD=

# ---- 前端对外端口 ----
WEB_PORT=80

# ---- 密钥（必填，缺失则容器启动失败）----
# 生成方式：openssl rand -hex 32
APP_JWT_SECRET=
APP_CRYPTO_AESKEY=
APP_CRYPTO_HMACKEY=

# ---- CORS 白名单，逗号分隔 ----
# 生产环境必须设为真实前端域名；留空则用 config/production/app.yaml 中的值
APP_CORS_ALLOWORIGINS=
