# ============================================================
# 本地开发环境变量示例 —— 复制为 .env 后填入真实值
#
# 注意：Docker 部署不使用本文件，而是 deploy/.env（由 deploy.sh 自动生成）。
# 本文件仅用于 make dev-api 的本地直跑场景。
#
# 生成随机密钥：make keygen
# ============================================================

# ---- 运行环境：development / testing / production ----
# 决定加载 apps/backend/config/{APP_ENV}/ 下的配置文件
APP_ENV=development

# ---- 数据库（覆盖 config/{env}/database.yaml）----
APP_MYSQL_HOST=127.0.0.1
APP_MYSQL_PORT=3306
APP_MYSQL_USERNAME=root
APP_MYSQL_PASSWORD=
APP_MYSQL_DATABASE=rbac_admin

# ---- Redis（覆盖 config/{env}/redis.yaml）----
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# ---- JWT ----
# 必填。生产环境必须为随机值（openssl rand -hex 32）
APP_JWT_SECRET=

# ---- 敏感字段加解密 ----
# AES-256-GCM 密钥：32 字节，用 64 位 hex 表示
APP_CRYPTO_AESKEY=
# HMAC 盲索引密钥：与 AES 密钥相互独立，隔离风险
APP_CRYPTO_HMACKEY=

# ---- 日志（覆盖 config/{env}/log.yaml）----
# APP_LOG_LEVEL=debug
# APP_LOG_FORMAT=text
